# Step 1: Create the Helm Chart Structure
mkdir -p three-tier-chart/templates
cd three-tier-chart

# Step 2: Create Chart.yaml

cat <<EOF > Chart.yaml
apiVersion: v2
name: three-tier-app
description: Helm chart for MySQL, Backend, and Frontend 3-Tier Application
type: application
version: 1.0.0
appVersion: "1.0.0"
EOF

# Step 3: Create values.yaml

cat <<EOF > values.yaml
mysql:
  image:
    repository: subratasikdar2021/mysql
    tag: latest
    pullPolicy: IfNotPresent
  storage:
    size: 10Gi
  credentials:
    rootPassword: "RootPassword@123"
    database: "appdb"
    user: "dbuser"
    password: "DbPassword@123"

backend:
  replicaCount: 2
  image:
    repository: subratasikdar2021/3-tier-devsecops-backend
    tag: latest
    pullPolicy: IfNotPresent
  service:
    port: 8080

frontend:
  replicaCount: 2
  image:
    repository: subratasikdar2021/3-tier-devsecops-frontend
    tag: latest
    pullPolicy: IfNotPresent
  service:
    type: LoadBalancer
    port: 80
EOF


# Step 4: Create the Kubernetes Templates: Now, create the templates that will read values from values.yaml.

# 1. MySQL Manifests (templates/mysql.yaml)


cat <<EOF > templates/mysql.yaml
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ .Release.Name }}-mysql-pvc
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: {{ .Values.mysql.storage.size }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ .Release.Name }}-mysql
  labels:
    app: {{ .Release.Name }}-mysql
spec:
  replicas: 1
  selector:
    matchLabels:
      app: {{ .Release.Name }}-mysql
  template:
    metadata:
      labels:
        app: {{ .Release.Name }}-mysql
    spec:
      containers:
        - name: mysql
          image: "{{ .Values.mysql.image.repository }}:{{ .Values.mysql.image.tag }}"
          imagePullPolicy: {{ .Values.mysql.image.pullPolicy }}
          env:
            - name: MYSQL_ROOT_PASSWORD
              value: {{ .Values.mysql.credentials.rootPassword | quote }}
            - name: MYSQL_DATABASE
              value: {{ .Values.mysql.credentials.database | quote }}
            - name: MYSQL_USER
              value: {{ .Values.mysql.credentials.user | quote }}
            - name: MYSQL_PASSWORD
              value: {{ .Values.mysql.credentials.password | quote }}
          ports:
            - containerPort: 3306
              name: mysql
          volumeMounts:
            - name: mysql-storage
              mountPath: /var/lib/mysql
      volumes:
        - name: mysql-storage
          persistentVolumeClaim:
            claimName: {{ .Release.Name }}-mysql-pvc
---
apiVersion: v1
kind: Service
metadata:
  name: {{ .Release.Name }}-mysql-svc
spec:
  selector:
    app: {{ .Release.Name }}-mysql
  ports:
    - port: 3306
      targetPort: 3306
  clusterIP: None
EOF


# 2. Backend Manifests (templates/backend.yaml)

cat <<EOF > templates/backend.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ .Release.Name }}-backend
  labels:
    app: {{ .Release.Name }}-backend
spec:
  replicas: {{ .Values.backend.replicaCount }}
  selector:
    matchLabels:
      app: {{ .Release.Name }}-backend
  template:
    metadata:
      labels:
        app: {{ .Release.Name }}-backend
    spec:
      containers:
        - name: backend
          image: "{{ .Values.backend.image.repository }}:{{ .Values.backend.image.tag }}"
          imagePullPolicy: {{ .Values.backend.image.pullPolicy }}
          env:
            - name: DB_HOST
              value: "{{ .Release.Name }}-mysql-svc"
            - name: DB_NAME
              value: {{ .Values.mysql.credentials.database | quote }}
            - name: DB_USER
              value: {{ .Values.mysql.credentials.user | quote }}
            - name: DB_PASSWORD
              value: {{ .Values.mysql.credentials.password | quote }}
          ports:
            - containerPort: {{ .Values.backend.service.port }}
              name: http
---
apiVersion: v1
kind: Service
metadata:
  name: {{ .Release.Name }}-backend-svc
spec:
  type: ClusterIP
  selector:
    app: {{ .Release.Name }}-backend
  ports:
    - port: {{ .Values.backend.service.port }}
      targetPort: {{ .Values.backend.service.port }}
EOF


# 3. Frontend Manifests (templates/frontend.yaml)

cat <<EOF > templates/frontend.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ .Release.Name }}-frontend
  labels:
    app: {{ .Release.Name }}-frontend
spec:
  replicas: {{ .Values.frontend.replicaCount }}
  selector:
    matchLabels:
      app: {{ .Release.Name }}-frontend
  template:
    metadata:
      labels:
        app: {{ .Release.Name }}-frontend
    spec:
      containers:
        - name: frontend
          image: "{{ .Values.frontend.image.repository }}:{{ .Values.frontend.image.tag }}"
          imagePullPolicy: {{ .Values.frontend.image.pullPolicy }}
          ports:
            - containerPort: {{ .Values.frontend.service.port }}
              name: http
---
apiVersion: v1
kind: Service
metadata:
  name: {{ .Release.Name }}-frontend-svc
spec:
  type: {{ .Values.frontend.service.type }}
  selector:
    app: {{ .Release.Name }}-frontend
  ports:
    - port: {{ .Values.frontend.service.port }}
      targetPort: {{ .Values.frontend.service.port }}
EOF


# Step 5: Test & Install the Chart: Navigate back out of the chart directory:
cd ..
# 1. Lint the Chart (Syntax Check)
helm lint ./three-tier-chart
# 2. Perform a Dry Run (Verify Rendered YAML)
helm install prod-release ./three-tier-chart --namespace three-tier-app --create-namespace --dry-run

# 3. Deploy the Chart
helm install prod-release ./three-tier-chart --namespace three-tier-app --create-namespace

# 4. Verify Deployment
# Check Helm releases
helm list -n three-tier-app

# Check pods status
kubectl get pods -n three-tier-app

# Get frontend load balancer URL
kubectl get svc -n three-tier-app



# Useful Helm Commands for Lifecycle Management
# Upgrade chart after changing values.yaml:
helm upgrade prod-release ./three-tier-chart -n three-tier-app

# Roll back to a previous revision:
helm rollback prod-release 1 -n three-tier-app

# Uninstall the release:
helm uninstall prod-release -n three-tier-app
